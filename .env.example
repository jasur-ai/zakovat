# Copy values from your password manager into your shell or Vercel dashboard.
# NEVER commit real tokens or send them in chat.
BOT_TOKEN=your_token_here
WEBHOOK_SECRET=your_random_secret_here

# Optional: public production domain. Vercel's own VERCEL_URL is a protected
# deployment URL, so the code prefers VERCEL_PROJECT_PRODUCTION_URL automatically.
WEBHOOK_URL=https://your-project.vercel.app

# Optional game defaults (users can still change them with buttons in chat)
ZAKOVAT_ROUNDS=3
ZAKOVAT_PER_ROUND=10
ZAKOVAT_TIMER_SECONDS=60
ZAKOVAT_PACKAGES_PER_PAGE=12
ZAKOVAT_ARCHIVE_DIR=data/all

# Three questions in a row without a single guess stop the game by itself (0 = off)
ZAKOVAT_IDLE_LIMIT=3

# Live countdown on serverless: how often the strip repaints itself (seconds),
# how each hop is run, and the switch that turns the ticks off (manual only)
ZAKOVAT_TICK_SECONDS=3
# bg  = the hop answers at once and paints after the response (default)
# sleep = the hop waits inline, for platforms without post-response work
ZAKOVAT_TICK_MODE=bg
ZAKOVAT_LIVE_TIMER=1

# How the game state hides inside a message: zero-width characters nobody can
# see or tap open (default), or the older spoiler rendering
ZAKOVAT_HIDDEN_STATE=invisible
